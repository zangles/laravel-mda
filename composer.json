{
    "name": "zangles/laravel-mda",
    "description": "Generadores y reglas de arquitectura para Model Domain Architecture (MDA) en Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "architecture", "mda", "generators", "pest", "arch"],
    "homepage": "https://zangles.github.io/MDA/",
    "authors": [
        {
            "name": "Guido Fonticelli",
            "email": "azuresky07@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "suggest": {
        "pestphp/pest": "Necesario para usar el preset de arquitectura MdaPreset (^3.0 o superior)."
    },
    "autoload": {
        "psr-4": {
            "Zangles\\Mda\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zangles\\Mda\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zangles\\Mda\\MdaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
