namespace {{ namespace }};

use {{ modelFqcn }};

/**
 * Persistencia básica de {{ model }}: crear, actualizar y borrar.
 *
 * - Las lecturas de entidades van en {{ model }}Finder y las consultas en {{ model }}Queries.
 * - Sin reglas de negocio: el Repository guarda lo que le dan.
 */
class {{ class }}{{ implements }}
{
    /**
     * @param  array<string, mixed>  $data
     */
    public function create(array $data): {{ model }}
    {
        return {{ model }}::create($data);
    }

    /**
     * @param  array<string, mixed>  $data
     */
    public function update({{ model }} $model, array $data): {{ model }}
    {
        $model->update($data);

        return $model;
    }

    public function delete({{ model }} $model): void
    {
        $model->delete();
    }
}
